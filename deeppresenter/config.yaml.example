#   #   response_format: "b64_json"
#   #   extra_body: { "watermark": False }

# Slidex critic and artifact configuration. Endpoints are OpenAI-compatible.
critic_model:
  # Keep neural critic controls on the same Friday model as generation/research.
  base_url: "https://aigc.sankuai.com/v1/openai/native"
  model: "gpt-4o-mini"
  api_key: "$FRIDAY_API_KEY"
  capabilities: { text: true, vision: true, tools: false, structured_output: true }
  sampling_parameters: { "temperature": 0, "top_p": 1 }
  requests_per_minute: 200
  max_concurrent: 24

judge_model:
  # Frozen independent secondary judge; this model must never generate or repair PPTs.
  base_url: "https://ark.cn-beijing.volces.com/api/v3"
  model: "doubao-seed-2-1-turbo-260628"
  api_key: "$ARK_JUDGE_API_KEY"
  capabilities: { text: true, vision: true, tools: false, structured_output: true }
  sampling_parameters: { "temperature": 0, "top_p": 1 }
  max_concurrent: 4

# semantic_model is optional and remains independent from policy history.
# semantic_model:
#   base_url: "https://openrouter.ai/api/v1"
#   model: "anthropic/claude-sonnet-4.5"
#   api_key: "$SLIDEX_API_KEY"
#   capabilities: { text: true, vision: false, tools: false, structured_output: true }
#   sampling_parameters: { "temperature": 0, "top_p": 1, "seed": 42 }

slidex:
  enforce_model_role_policy: true
  # Frozen snapshot for this experiment revision: design_agent/judge_model
  # above must match these exactly (self-consistency check, no model name
  # hardcoded in Python). To switch models for a new revision, update the
  # endpoint config and these fields together.
  frozen_generation_model: "gpt-4o-mini"
  frozen_generation_base_url: "https://aigc.sankuai.com/v1/openai/native"
  frozen_generation_requests_per_minute: 200
  frozen_judge_model: "doubao-seed-2-1-turbo-260628"
  frozen_judge_base_url: "https://ark.cn-beijing.volces.com/api/v3"
  taxonomy_version: "1.0"
  authoring_skill_version: "1.0"
  router_version: "1.0"
  reward_version: "1.0"
  # Frozen hard-gate thresholds; changing one requires a reward version bump.
  reward_terminal_hard_negative: -1
  reward_severe_defect_threshold: 0.7
  reward_inspector_error_penalty: 0.2
  reward_inspector_error_invalidation_count: 2
  reward_policy_penalty_per_severity: 0.25
  safety_margin_px: 24
  alignment_tolerance_px: 2
  overlap_tolerance_px: 1
  palette_threshold: 0.1
  overlap_min_area_px: 4
  color_delta_e_threshold: 5
  typography_tolerance_px: 1
  max_repair_rounds: 3
  max_episode_steps: 40
  max_turns_per_slide: 6
  command_timeout_seconds: 300
  strict_export: true
  pptx_rerender: true
  export_max_pixel_difference: 0.12
  export_min_perceptual_similarity: 0.90
  export_min_text_presence: 0.95
  mutation_zero_signal_threshold: 0.001
  reference_policy: "on_defer"
  max_workspace_bytes: 2147483648
  max_artifacts_per_episode: 1000
  artifact_retention_seconds: 604800
