# Slidex configuration
context_folding: true
offline_mode: false
async_tool_mode: false

research_agent:
  # Switched from Friday Gemini 3.6 Flash to Friday GPT-4o-mini (RPM 200 vs 20).
  base_url: "https://aigc.sankuai.com/v1/openai/native"
  model: "gpt-4o-mini"
  api_key: "$FRIDAY_API_KEY"
  capabilities: { text: true, vision: true, tools: true, structured_output: true }
  sampling_parameters: { "temperature": 0, "top_p": 1 }
  requests_per_minute: 200
  max_concurrent: 24

design_agent:
  # Frozen generation policy: all PPT generation uses Friday GPT-4o-mini.
  # Must match slidex.frozen_generation_* below (self-consistency check).
  base_url: "https://aigc.sankuai.com/v1/openai/native"
  model: "gpt-4o-mini"
  api_key: "$FRIDAY_API_KEY"
  capabilities: { text: true, vision: true, tools: true, structured_output: true }
  sampling_parameters: { "temperature": 0, "top_p": 1 }
  requests_per_minute: 200
  max_concurrent: 24

long_context_model:
  base_url: "https://aigc.sankuai.com/v1/openai/native"
  model: "gpt-4o-mini"
  api_key: "$FRIDAY_API_KEY"
  capabilities: { text: true, vision: true, tools: false, structured_output: true }
  sampling_parameters: { "temperature": 0, "top_p": 1 }
  requests_per_minute: 200
  max_concurrent: 24

# # LiteLLM provider example — pip install slidex[litellm]
